Bootstrap: docker
From: pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

%labels
    Author Temporal Event Spiking Research
    Scope event-dataset-baselines

%help
    Il repository deve essere montato su /workspace, che configurazioni,
    dataset, output e PYTHONPATH assumono:

        singularity exec --cleanenv --nv \
            --bind <repo>:/workspace \
            --pwd /workspace \
            temporal-event-spiking.sif \
            python -m etsr.cli train --config <config>

    Senza il bind del repository il package etsr non e' importabile. Screen deve
    essere avviato sull'host prima di singularity, cosi' il processo sopravvive
    alla disconnessione SSH. Usare --nv per la GPU e un SIF non scrivibile.

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git \
        make \
        ca-certificates
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade \
        "numpy>=1.24,<2.0" \
        "PyYAML>=6.0,<7" \
        "pytest>=8,<9" \
        "ruff>=0.6,<0.8"

%environment
    export PYTHONUNBUFFERED=1
    # Impedisce che ~/.local della home montata scherni i pacchetti del container.
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/workspace/src:$PYTHONPATH
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
    export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}

%test
    make --version >/dev/null
    python -c "import torch, numpy, yaml; print(torch.__version__, numpy.__version__)"

%runscript
    exec python "$@"
